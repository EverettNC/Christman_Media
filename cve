}

# --- Caption style registry ---
CAPTION_PRESETS = {k: v for k, v in CAPTION_STYLES.items()}


def load_template(template_path: str, slots: dict) -> Timeline:
    """Load JSON template and fill slots."""
    with open(template_path, "r") as f:
        data = json.load(f)

    tl_data = data["timeline"]

    # Simple slot replacement in JSON string
    import re
    json_str = json.dumps(tl_data)
    for key, value in slots.items():
        json_str = json_str.replace(f"{{{{{key}}}}}", str(value))
    tl_data = json.loads(json_str)

    # Reconstruct Timeline
    tl = Timeline(
        fps=tl_data.get("fps", 30),
        resolution=ResolutionPreset[tl_data.get("resolution", "FHD_1080")],
        theme=THEMES.get(tl_data.get("theme", "steampunk"), STEAMPUNK_THEME),
        background_color=tl_data.get("background_color", "0x1a1a2e"),
    )

    for track_data in tl_data.get("tracks", []):
        track = Track(TrackType(track_data["type"]))
        track.volume = track_data.get("volume", 1.0)
        track.enabled = track_data.get("enabled", True)

        for clip_data in track_data.get("clips", []):
            clip = Clip(
                source=clip_data["source"],
                start=clip_data.get("start", 0),
                duration=clip_data.get("duration"),
                trim_start=clip_data.get("trim_start", 0),
                trim_end=clip_data.get("trim_end"),
                scale_mode=clip_data.get("scale_mode", "fit"),
                position=tuple(clip_data.get("position", [0, 0])),
                opacity=clip_data.get("opacity", 1.0),
                transition=TransitionType(clip_data.get("transition", "none")),
                transition_duration=clip_data.get("transition_duration", 0.5),
                effects=clip_data.get("effects", []),
                tts_text=clip_data.get("tts_text"),
                tts_voice=clip_data.get("tts_voice", "derek"),
                tts_emotion=clip_data.get("tts_emotion", "neutral"),
                subtitle_text=clip_data.get("subtitle_text"),
                subtitle_style=clip_data.get("subtitle_style"),
            )
            track.add_clip(clip)

        tl.add_track(track)

    return tl


def cmd_render(args):
    """Render a timeline template or quick prompt."""
    output_path = args.output or "data/output/render.mp4"
    Path(output_path).parent.mkdir(parents=True, exist_ok=True)

    if args.template:
        # Template-based render
        slots = {}
        if args.slots:
            for slot in args.slots:
                if "=" in slot:
                    k, v = slot.split("=", 1)
                    slots[k] = v

        print(f"[CVE] Loading template: {args.template}")
        print(f"[CVE] Slots: {slots}")
        timeline = load_template(args.template, slots)

    elif args.prompt:
        # Quick prompt render
        print(f"[CVE] Quick render: {args.prompt}")
        theme = THEMES.get(args.theme, STEAMPUNK_THEME)
        result = quick_render(
            prompt=args.prompt,
            output_path=output_path,
            voice=args.voice,
            emotion=args.emotion,
            theme=theme,
            duration=args.duration
        )
        _print_result(result)
        return

    else:
        print("Error: --template or --prompt required")
        sys.exit(1)

    # Render with full pipeline
    caption_style = CAPTION_PRESETS.get(args.caption_style, CAPTION_STYLES["kids_large"])
    result = render_timeline(
        timeline=timeline,
        output_path=output_path,
        work_dir=args.work_dir,
        burn_captions=not args.no_captions,
        caption_style=args.caption_style
    )
    _print_result(result)


