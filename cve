def cmd_list(args):
    """List available templates, themes, voices."""
    any_shown = False

    if args.templates:
        templates_dir = PROJECT_ROOT / "assets" / "templates"
        if templates_dir.exists():
            for t in templates_dir.glob("*.json"):
                with open(t) as f:
                    data = json.load(f)
                print(f"  {t.stem}: {data.get('description', '')}")
                for slot in data.get("slots", []):
                    req = " (required)" if slot.get("required") else ""
                    default = f" [default: {slot.get('default')}]" if slot.get("default") else ""
                    print(f"    --slot {slot['name']}={slot['type']}{req}{default}")
        else:
            print("No templates found")
        any_shown = True

    if args.themes:
        for name, theme in THEMES.items():
            print(f"  {name}: {theme.name}")
        any_shown = True

    if args.caption_styles:
        for name in CAPTION_PRESETS:
            print(f"  {name}")
        any_shown = True

    if args.voices:
        # List voice profiles
        profiles_dir = Path("/Users/EverettN/.christman_ai/voice_profiles")
        if profiles_dir.exists():
            for p in profiles_dir.glob("*.json"):
                with open(p) as f:
                    data = json.load(f)
                print(f"  {data.get('id', p.stem)}: {data.get('name', '')} ({data.get('voice', {}).get('voice', '')})")
        else:
            print("No voice profiles found")
        any_shown = True

    if not any_shown:
        print("Use --templates, --themes, --caption-styles, or --voices")


