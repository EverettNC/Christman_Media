def cmd_bridge(args):
    """Bridge utilities."""
    import urllib.request
    import urllib.error

    if args.health:
        try:
            with urllib.request.urlopen("http://localhost:8765/health", timeout=3) as r:
                print(r.read().decode())
        except Exception as e:
            print(f"Bridge not reachable: {e}")

    if args.transcript:
        try:
            with urllib.request.urlopen("http://localhost:8765/latest", timeout=3) as r:
                data = json.loads(r.read().decode())
                print(f"Transcript: {data.get('text', '(empty)')}")
                print(f"Timestamp: {data.get('timestamp', 0)}")
        except Exception as e:
            print(f"Error: {e}")

    if args.riley_status:
        try:
            with urllib.request.urlopen("http://localhost:8765/riley/status", timeout=3) as r:
                print(r.read().decode())
        except Exception as e:
            print(f"Error: {e}")

    if args.send_riley:
        try:
            payload = json.dumps({"text": args.send_riley}).encode()
            req = urllib.request.Request(
                "http://localhost:8765/riley/claude-response",
                data=payload,
                headers={"Content-Type": "application/json"},
                method="POST"
            )
            with urllib.request.urlopen(req, timeout=3) as r:
                print(r.read().decode())
        except Exception as e:
            print(f"Error: {e}")


def _print_result(result: RenderResult):
    if result.success:
        print(f"\n✅ RENDER COMPLETE")
        print(f"   Output: {result.output_path}")
        print(f"   Duration: {result.duration:.2f}s")
        print(f"   Size: {result.file_size / 1024 / 1024:.2f} MB")
    else:
        print(f"\n❌ RENDER FAILED")
        print(f"   Error: {result.error}")
        sys.exit(1)


